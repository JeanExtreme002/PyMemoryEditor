# Coverage config for the informational app measurement in the `build-speed`
# CI job, which runs `pytest tests/app`.
#
# The library gate (.coveragerc-lib) omits PyMemoryEditor/app: most of it is
# widget wiring the suite does not drive, so counting it there would make the
# library's floor measure the UI. That left the app unmeasured altogether.
# This config measures it on its own, with no floor, under its own Codecov
# flag, so a gate can be chosen from an observed trend rather than a guess.
[run]
# A plain value, not a TOML list: this is an INI file (see .coveragerc-lib).
source = PyMemoryEditor/app

[report]
show_missing = True
skip_empty = True
